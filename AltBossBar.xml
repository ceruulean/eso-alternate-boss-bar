<GuiXml>
  <Controls>

    <TopLevelControl name="ABBBar" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="300" y="30"/>
      <Anchor point="CENTER" relativeTo="GuiRoot" />

      <Controls>

        <StatusBar name="$(parent)Status"
                   min="0"
                   max="100"
                   color="0,0.8,0"
                   >
          <Dimensions x="300" y="30"/>
          <AnchorFill/>
        </StatusBar>

        <Label name="$(parent)Label"
               font="ZoFontGameLarge"
               horizontalAlignment="CENTER"
               verticalAlignment="CENTER">
          <AnchorFill/>
        </Label>

      </Controls>

    </TopLevelControl>

  </Controls>
</GuiXml>